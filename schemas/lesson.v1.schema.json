{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DEVORQ Lesson v1",
  "type": "object",
  "required": ["schema_version", "document_type", "run_id", "id", "hypothesis", "action", "result", "status"],
  "properties": {
    "schema_version": { "const": "devorq.lesson/v1" },
    "document_type": { "const": "lesson" },
    "run_id": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "result": { "type": "string", "minLength": 1 },
    "status": { "enum": ["captured", "validated", "rejected"] }
  }
}
