{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DEVORQ Story v1",
  "type": "object",
  "required": ["schema_version", "document_type", "run_id", "id", "title", "description", "acceptance_criteria", "status"],
  "properties": {
    "schema_version": { "const": "devorq.story/v1" },
    "document_type": { "const": "story" },
    "run_id": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["pending", "planning", "running", "verifying", "completed", "failed", "blocked", "requires_owner_decision", "max_attempts_reached", "cancelled"] }
  }
}
