{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DEVORQ Evidence v1",
  "type": "object",
  "required": ["schema_version", "document_type", "run_id", "id", "evidence_type", "path", "sha256", "result"],
  "properties": {
    "schema_version": { "const": "devorq.evidence/v1" },
    "document_type": { "const": "evidence" },
    "run_id": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "evidence_type": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "result": { "enum": ["passed", "failed", "blocked"] }
  }
}
